{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KORA AI Route",
  "type": "object",
  "required": ["requestId", "intent", "destination"],
  "properties": {
    "requestId": { "type": "string" },
    "intent": { "type": "string" },
    "destination": {
      "enum": ["learn", "nav", "sport", "news", "music", "tv", "radio", "general"]
    },
    "mode": { "enum": ["standard", "driver_safe", "emergency"] },
    "language": { "type": "string" },
    "requiresLiveData": { "type": "boolean" },
    "requiresVerifiedSource": { "type": "boolean" },
    "context": { "type": "object" }
  }
}
