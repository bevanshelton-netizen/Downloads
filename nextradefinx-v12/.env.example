# Public Supabase project settings used by the web app. Do not place service-role secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only operational flags. V12 remains educational/paper-only.
LIVE_EXECUTION_ENABLED=false
CLIENT_FUNDS_ENABLED=false
PERSONALIZED_ADVICE_ENABLED=false
BROKER_ADAPTER_ENABLED=false
