# FAISReady bootstrap revenue host
PUBLIC_BASE_URL=https://faisready.example.com
FAISREADY_DATA_DIR=
FAISREADY_BACKUP_DIR=
FAISREADY_TRUST_CLOUDFLARE=true
FAISREADY_ALLOW_HTTP_BASE=false

# Stable named HTTPS edge. Prefer TUNNEL_TOKEN_FILE where practical.
# Never commit the real token or token file.
TUNNEL_TOKEN=
TUNNEL_TOKEN_FILE=

# Native payment orchestration.
# FAISReady talks to IZAKHONO PAY; settlement providers remain behind IZAKHONO PAY.
FAISREADY_PAYMENT_ORCHESTRATOR=izakhono
IZAKHONO_PAY_URL=
IZAKHONO_PAY_API_KEY=
IZAKHONO_PAY_WEBHOOK_SECRET=

# Provider-specific direct PayFast settings are retained only as rollback/sandbox rail.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Fail-closed switch for any live PayFast settlement endpoint returned by IZAKHONO PAY.
# Leave false until that external merchant rail has been approved and tested.
FAISREADY_IZAKHONO_PAY_LIVE_APPROVED=false

# Later distributed-platform migration / optional live modules
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
