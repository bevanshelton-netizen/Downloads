# FAISReady bootstrap revenue host
PUBLIC_BASE_URL=https://faisready.example.com
FAISREADY_DATA_DIR=
FAISREADY_BACKUP_DIR=
FAISREADY_TRUST_CLOUDFLARE=true
FAISREADY_ALLOW_HTTP_BASE=false

# Cloudflare named tunnel. Prefer TUNNEL_TOKEN_FILE where practical.
# Never commit the real token or token file.
TUNNEL_TOKEN=
TUNNEL_TOKEN_FILE=

# Existing direct PayFast path remains available for rollback.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Payment orchestration rollout. Keep `direct` until IZAKHONO PAY sandbox proof passes.
FAISREADY_PAYMENT_ORCHESTRATOR=direct
IZAKHONO_PAY_URL=
IZAKHONO_PAY_API_KEY=
IZAKHONO_PAY_WEBHOOK_SECRET=
# A live PayFast endpoint returned through IZAKHONO PAY is rejected unless this is true.
FAISREADY_IZAKHONO_PAY_LIVE_APPROVED=false

# Later distributed-platform migration / optional live modules
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
