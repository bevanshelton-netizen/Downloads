# FAISReady bootstrap revenue host
PUBLIC_BASE_URL=https://faisready.co.za
FAISREADY_DATA_DIR=
FAISREADY_BACKUP_DIR=
FAISREADY_TRUST_CLOUDFLARE=true
FAISREADY_ALLOW_HTTP_BASE=false

# Payment provider selector.
# Production preference: ikhokha. PayFast remains the sandbox/fallback rail.
FAISREADY_PAYMENT_PROVIDER=ikhokha

# iKhokha iK Pay API (production preference).
# Generate the App ID and App Secret in the authorised iKhokha Merchant Dashboard.
IKHOKHA_APP_ID=
IKHOKHA_APP_SECRET=
# Fail closed until the real owner-host, named hostname and one controlled
# transaction are ready to be tested.
IKHOKHA_LIVE_APPROVED=false

# Cloudflare named tunnel. Prefer TUNNEL_TOKEN_FILE where practical.
# Never commit the real token or token file.
TUNNEL_TOKEN=
TUNNEL_TOKEN_FILE=

# PayFast sandbox/fallback path.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
FAISREADY_LIVE_PAYMENTS_APPROVED=false

# Optional IZAKHONO PAY orchestration path.
FAISREADY_PAYMENT_ORCHESTRATOR=direct
IZAKHONO_PAY_URL=
IZAKHONO_PAY_API_KEY=
IZAKHONO_PAY_WEBHOOK_SECRET=
FAISREADY_IZAKHONO_PAY_LIVE_APPROVED=false

# Later distributed-platform migration / optional live modules
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
