[Unit]
Description=IZAKHONO AI GATEWAY NODE
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/izakhono-ai-gateway-node
EnvironmentFile=/etc/izakhono/ai-gateway-node.env
ExecStart=/usr/bin/node /opt/izakhono-ai-gateway-node/server.mjs
Restart=always
RestartSec=3
User=izakhono
Group=izakhono
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/izakhono-ai-gateway
Environment=IZAKHONO_AI_GATEWAY_DB=/var/lib/izakhono-ai-gateway/gateway.sqlite

[Install]
WantedBy=multi-user.target
