{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__APP_SLUG__",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "__APP_NAME__"
  }
}
