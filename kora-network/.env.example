NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
# Leave as public for a dedicated KORA Supabase project.
# Shared IZAKHONO identity mode uses kora so FAISReady public tables remain isolated.
