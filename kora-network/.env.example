CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# IZAKHONO-owned runtime is the KORA production primary.
# External providers are replaceable resilience only and must never be required for launch.
KORA_PRIMARY_RUNTIME=owned
KORA_FALLBACK_RUNTIME=other
KORA_STREAMING_READY=false

PAYFAST_MERCHANT_ID=
