NEXT_PUBLIC_APP_NAME=KORA
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
# Leave as public for a dedicated KORA Supabase project.
# Shared IZAKHONO identity mode uses kora so FAISReady public tables remain isolated.
NEXT_PUBLIC_KORA_DB_SCHEMA=kora
KORA_DB_SCHEMA=kora
# Preferred Supabase API keys for new projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback keys remain supported during migration through end-2026.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# mock or cloudflare
VIDEO_PROVIDER=mock
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# Existing direct PayFast path remains available for recurring subscriptions and rollback.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# iKhokha is preferred automatically for one-time PPV purchases when both values are present.
# Live ticket checkout also uses iKhokha when KORA_TICKET_CHECKOUT_MODE=live.
# Keep these server-only; never expose them through NEXT_PUBLIC_* variables.
IKHOKHA_APP_ID=
IKHOKHA_APP_SECRET=

# Legacy payment orchestration rollout. `direct` preserves the direct PayFast path when iKhokha is absent.
# `izakhono` routes supported one-time purchases/tickets through IZAKHONO PAY when iKhokha is absent.
KORA_PAYMENT_ORCHESTRATOR=direct
IZAKHONO_PAY_URL=
IZAKHONO_PAY_API_KEY=
IZAKHONO_PAY_WEBHOOK_SECRET=
KORA_IZAKHONO_PAY_LIVE_APPROVED=false

# off, sandbox_staff, or live. Direct live requires KORA_TICKET_LIVE_APPROVED=true.
# IZAKHONO live additionally requires KORA_IZAKHONO_PAY_LIVE_APPROVED=true.
KORA_TICKET_CHECKOUT_MODE=off
KORA_TICKET_LIVE_APPROVED=false

# Long random secret used only by trusted server-to-server callbacks (32+ characters in production).
KORA_INTERNAL_API_SECRET=

# Complete these only after the operating entity and public contacts are approved.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_RIGHTS_EMAIL=

# Explicit go-live gates. Keep false until the named operating process is genuinely signed off.
KORA_LEGAL_APPROVED=false
KORA_REGULATORY_APPROVED=false
KORA_CHILD_SAFETY_APPROVED=false
KORA_PAYOUT_OPERATIONS_APPROVED=false
KORA_BACKUP_OPERATIONS_APPROVED=false
KORA_INCIDENT_RESPONSE_APPROVED=false

# Optional private-beta account creation. Keep false/absent on public production unless deliberately needed.
KORA_PRIVATE_SIGNUP_ENABLED=false

# Browser-safe IZAKHONO Analytics collector origin. Runtime only; leave blank until the HTTPS collector is published.
IZAKHONO_ANALYTICS_URL=

# One-time local/operator shell variable used only by `npm run bootstrap:admin -- email@example.com`.
# Set temporarily to BOOTSTRAP_FIRST_ADMIN and remove immediately after the first administrator exists.
KORA_BOOTSTRAP_CONFIRM=
