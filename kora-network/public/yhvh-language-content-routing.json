  "targeting_workflow": [
    "1. Identify language from audio/transcript/metadata.",
    "2. Assign primary language and secondary languages.",
    "3. Assign country/region of origin.",
    "4. Match content to churches, ministries, artists, choirs, broadcasters, radio, OTT and distributors using that language.",
    "5. Match translation/subtitle opportunities where language differs from the target market.",
    "6. Complete rights, safeguarding and disclaimer checks.",
    "7. Only then move content to acquisition-ready or broadcast-ready status."
  ]
