{
  "doctrine": {
    "name": "IZAKHONO EVERYTHING",
    "owner": "IZAKHONO AFRICA",
    "rule": "Own every core capability. External infrastructure, APIs and providers are reversible bootstrap or overflow only.",
    "no_tracking": true,
    "no_behavioural_profiling": true,
    "no_advertising_ids": true,
    "open_import_export": true,
    "one_account": true,
    "one_ai": true,
    "owned_compute_primary": true,
    "external_fallback_reversible": true,
    "live_claim_requires_verification": true
  },
  "quality_bar": [
    "privacy",
    "simplicity",
    "interoperability",
    "African languages and local relevance",
    "accessibility",
    "cost efficiency",
    "data portability",
    "cross-product integration",
    "reliability",
    "owner control"
  ],
  "pillars": [
    {
      "id": "one",
      "name": "IZAKHONO ONE",
      "scope": "identity, home, universal navigation and AI operating layer"
    },
    {
      "id": "ai",
      "name": "IZAKHONO ONE AI",
      "scope": "assistant, agents, search/reasoning, orchestration, memory/knowledge with user control"
    },
    {
