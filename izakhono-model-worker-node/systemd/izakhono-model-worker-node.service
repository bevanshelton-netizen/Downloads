[Unit]
Description=IZAKHONO MODEL WORKER NODE
After=network-online.target izakhono-gpu-compute-node.service
Wants=network-online.target

[Service]
Type=simple
User=izakhono
Group=izakhono
WorkingDirectory=/opt/izakhono-model-worker-node
EnvironmentFile=/etc/izakhono/model-worker.env
ExecStart=/usr/bin/node /opt/izakhono-model-worker-node/server.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
