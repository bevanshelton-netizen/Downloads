{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kora.africa/schemas/policy.schema.json",
  "title": "KORA Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyId", "version", "status", "rules", "updatedAt"],
  "properties": {
    "policyId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "active", "superseded", "suspended", "revoked"] },
    "jurisdictionRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "organisationRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "serviceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "resourceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "purpose": { "type": "string" },
    "priority": { "type": "integer", "minimum": 0 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "effect", "conditions"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "enum": ["allow", "deny", "conditional", "step-up"] },
          "conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "reason": { "type": "string" }
        }
      }
    },
    "effectiveFrom": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
