[Unit]
Description=IZAKHONO Automations
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=izakhono
Group=izakhono
WorkingDirectory=/opt/izakhono-automations
EnvironmentFile=/etc/izakhono-automations.env
ExecStart=/usr/bin/python3 /opt/izakhono-automations/app.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/izakhono-automations/data

[Install]
WantedBy=multi-user.target
