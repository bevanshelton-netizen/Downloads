# KORA GOSPEL TV simulcast configuration
# Copy this file to /etc/izakhono/kora-gospel-tv-simulcast.env on the owned host.
# chmod 600 the real file. Never commit real stream keys or destination URLs containing secrets.

# Master feed produced/owned by IZAKHONO.
GOSPEL_MASTER_INPUT_URL=rtmp://127.0.0.1/live/gospel
GOSPEL_TRANSCODE_MODE=copy

# Enable only after the matching external account/channel is connected.
GOSPEL_OUTPUT_1_LABEL=YouTube Live
GOSPEL_OUTPUT_1_ENABLED=0
GOSPEL_OUTPUT_1_URL=rtmps://EXAMPLE/REPLACE-WITH-SECRET-STREAM-URL

GOSPEL_OUTPUT_2_LABEL=Facebook Live
GOSPEL_OUTPUT_2_ENABLED=0
GOSPEL_OUTPUT_2_URL=rtmps://EXAMPLE/REPLACE-WITH-SECRET-STREAM-URL

GOSPEL_OUTPUT_3_LABEL=External CDN / Partner
GOSPEL_OUTPUT_3_ENABLED=0
GOSPEL_OUTPUT_3_URL=rtmps://EXAMPLE/REPLACE-WITH-DESTINATION

# Slots 4-8 are reserved for future distribution partners.
