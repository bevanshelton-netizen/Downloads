[Unit]
Description=IZAKHONO Infrastructure Executor
After=network-online.target izakhono-code-node.service izakhono-queue-node.service izakhono-ci-worker-node.service
Wants=network-online.target izakhono-code-node.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/izakhono-infrastructure-executor
EnvironmentFile=-/etc/izakhono/infrastructure-executor.env
ExecStart=/bin/bash /opt/izakhono-infrastructure-executor/run-once.sh
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
