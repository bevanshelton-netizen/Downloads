# IZAKHONO PAY shared group gateway — owner-host configuration
# Copy to izakhono-pay/.env.local on the owner host. Never commit real values.

IZAKHONO_PAY_DATA_DIR=
IZAKHONO_PAY_PUBLIC_BASE_URL=https://pay.example.com

# Primary one-time online payment rail: iKhokha iK Pay API.
# iKhokha merchant account is live. Keep both credentials server-only.
IKHOKHA_APP_ID=
IKHOKHA_APP_SECRET=
IKHOKHA_MODE=live
IZAKHONO_PAY_EFT_FALLBACK=true

# Optional customer return destinations after hosted checkout.
# Populate only domains that have passed public HTTPS + end-to-end acceptance.
IZAKHONO_PAY_RETURN_URLS_JSON={"faisready":"https://faisready.example.com/payment/return","edubuild-ecd360":"https://edubuild.example.com/payment/return","crowne-hair":"https://hair.domains.izakhonoafrica.co.za/payment/return"}

# Per-platform API keys. Generate unique random values on the owner host.
# Never reuse one key across platforms and never expose these in browser/VITE variables.
IZAKHONO_PAY_APPS_JSON={"faisready":"set-on-owner-host","edubuild-ecd360":"set-on-owner-host","studypal-welearn":"set-on-owner-host","auto-ai":"set-on-owner-host","doxa-sure":"set-on-owner-host","mandatory-regulatory-exams":"set-on-owner-host","allegro-vibez":"set-on-owner-host","kora":"set-on-owner-host","the-chancellor":"set-on-owner-host","crowne-hair":"set-on-owner-host"}

# Platform callback destinations and webhook signing secrets.
# Real public hostnames/secrets belong only in owner-host configuration.
# Add each platform only after its signed payment.paid receiver has passed acceptance testing.
IZAKHONO_PAY_CALLBACK_URLS_JSON={"faisready":"https://faisready.example.com/api/izakhono-pay/webhook","edubuild-ecd360":"https://edubuild.example.com/api/izakhono-pay/webhook"}
IZAKHONO_PAY_CALLBACK_SECRETS_JSON={"faisready":"set-on-owner-host","edubuild-ecd360":"set-on-owner-host"}

# Merchant EFT settlement account. Keep the real account number only in .env.local.
IZAKHONO_PAY_BANK_NAME=FNB
IZAKHONO_PAY_ACCOUNT_NAME=IZAKHONO AFRICA (PTY) LTD
IZAKHONO_PAY_ACCOUNT_NUMBER=
IZAKHONO_PAY_ACCOUNT_TYPE=Gold Business Account
IZAKHONO_PAY_BRANCH_CODE=250655

# Automatic bank reconciliation connector.
# Keep disabled until FNB or an authorised banking/open-banking provider supplies production access.
# The adapter may push normalized settled-credit events to the loopback bank reconciler.
IZAKHONO_PAY_BANK_FEED_PROVIDER=manual
IZAKHONO_PAY_BANK_FEED_URL=
IZAKHONO_PAY_BANK_FEED_CLIENT_ID=
IZAKHONO_PAY_BANK_FEED_CLIENT_SECRET=
IZAKHONO_PAY_BANK_FEED_SIGNING_SECRET=
IZAKHONO_PAY_BANK_FEED_ENABLED=false
