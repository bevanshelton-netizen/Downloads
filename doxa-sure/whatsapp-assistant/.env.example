# DOXA-SURE WhatsApp Business Assistant
# Never commit real secret values.

# Meta webhook verification token: generate a long random value.
WHATSAPP_VERIFY_TOKEN=replace_with_random_verify_token

# Meta WhatsApp Business Platform access token.
WHATSAPP_ACCESS_TOKEN=replace_with_meta_access_token

# Meta WhatsApp phone-number ID for the business number connected to the Cloud API.
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id

# Meta app secret used to validate X-Hub-Signature-256 on incoming webhook POSTs.
META_APP_SECRET=replace_with_meta_app_secret

# Use the Graph API version shown in the Meta developer dashboard, for example vXX.X.
META_GRAPH_VERSION=vXX.X
