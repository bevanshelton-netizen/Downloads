# Server-only values. Never place these in config.js or browser code.
DOXA_PAYMENT_CALLBACK_ENABLED=false
DOXA_IZAKHONO_PAY_CALLBACK_SECRET=
# Owner-controlled mode stores data in a dedicated persistent volume.
DOXA_DATA_DIR=/var/lib/doxa-sure
# Supabase remains an optional future adapter and is not required in owner mode.
DOXA_SUPABASE_URL=
DOXA_SUPABASE_SERVICE_ROLE_KEY=
