# YHVH GOSPEL ENGINE
# Copy to /etc/izakhono/yhvh-gospel-engine.env and chmod 600.
HOST=127.0.0.1
PORT=8892
YHVH_GOSPEL_ENGINE_TOKEN=REPLACE-WITH-32-PLUS-CHARACTER-OWNER-TOKEN
YHVH_GOSPEL_ENGINE_DATA_DIR=/var/lib/izakhono-runtime/data/yhvh-gospel-engine
YHVH_GOSPEL_ENGINE_TIMEZONE=Africa/Johannesburg

# Replaceable distribution adapters. Credentials live in their own protected adapters,
# never in this engine file.
YHVH_ADAPTER_YOUTUBE=0
YHVH_ADAPTER_FACEBOOK=0
YHVH_ADAPTER_SMART_TV=0
YHVH_ADAPTER_OTT_PARTNER=0
YHVH_ADAPTER_SOCIAL_CLIPS=0
