{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":null,
  "rewrites":[{"source":"/","destination":"/index.html"}],
  "functions":{"api/*.mjs":{"maxDuration":30}},
  "headers":[
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(self), microphone=(self), geolocation=()"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
    ]}
  ]
}
