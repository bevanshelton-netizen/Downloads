[Unit]
Description=IZAKHONO DNS NODE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=izakhono-dns
Group=izakhono-dns
EnvironmentFile=/etc/izakhono/dns-node.env
ExecStart=/usr/bin/node /opt/izakhono-dns-node/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/izakhono-dns
ReadOnlyPaths=/etc/izakhono/dns-zone.json /etc/izakhono/dns-node.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
