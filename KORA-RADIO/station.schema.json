{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KORA Radio Station",
  "type": "object",
  "required": ["stationId", "name", "mode", "status", "outputs"],
  "properties": {
    "stationId": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "mode": {"enum": ["scheduled", "live", "simulcast", "emergency", "offline"]},
    "status": {"enum": ["READY", "ON_AIR", "DEGRADED", "FAILOVER", "OFFLINE"]},
    "activeSessionId": {"type": ["string", "null"]},
    "scheduleId": {"type": ["string", "null"]},
    "language": {"type": "string"},
    "region": {"type": "string"},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["outputId", "kind", "enabled"],
        "properties": {
          "outputId": {"type": "string"},
          "kind": {"enum": ["web", "mobile", "smart-speaker", "radio-visual", "partner", "archive"]},
          "enabled": {"type": "boolean"},
          "endpointRef": {"type": ["string", "null"]},
          "emergencyOverride": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
